# Google Ads API Configuration for Manager Account (MCC) Example
# Copy this file to 'google-ads.yaml' and fill in your credentials.
# Keep 'google-ads.yaml' private and NEVER commit it to source control.

developer_token: "INSERT_DEVELOPER_TOKEN_HERE"
client_id: "INSERT_OAUTH_CLIENT_ID_HERE.apps.googleusercontent.com"
client_secret: "INSERT_OAUTH_CLIENT_SECRET_HERE"
refresh_token: "INSERT_REFRESH_TOKEN_HERE"
login_customer_id: "INSERT_MCC_CUSTOMER_ID_WITHOUT_HYPHENS"
use_proto_plus: true
